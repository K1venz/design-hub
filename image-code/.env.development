# 开发环境配置（不含真密钥，可入库）。真实凭据用 .env（已 gitignore）或环境变量覆盖。
# 本地 MySQL 示例（按需在 .env 覆盖）：mysql+aiomysql://root:<password>@127.0.0.1:3306/image_gen
DB_URL=sqlite+aiosqlite:///./design_hub.db
REDIS_URL=redis://127.0.0.1:6379/0
REAL_GPT_IMAGE=false

# Keep local execution intentionally small. Raise provider concurrency only after
# upstream quota confirmation and staged load testing.
PROVIDER_STANDARD_CONCURRENCY=3
PROVIDER_4K_CONCURRENCY=1
WORKER_READ_COUNT=8
WORKER_READ_BLOCK_MS=1000
WORKER_RECLAIM_IDLE_MS=30000
WORKER_DISPATCH_INTERVAL_SECONDS=0.2
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
QUEUE_ROLLING_ITEM_SECONDS=60

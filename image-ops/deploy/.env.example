# design-hub 部署环境变量模板。
# 真实 .env 由 scripts/deploy.sh 在服务器上生成（密钥不入库），本文件仅作说明。

# === 数据库（决策②B：建库 design_hub，应用用 root 连） ===
# root 密码由 deploy.sh 从 /opt/docker/mysql/.env 读取并 URL 编码后填入；host=mysql 来自 mysql_default 网络
DB_URL=mysql+aiomysql://root:__URLENCODED_PW__@mysql:3306/design_hub

# === 出图/素材/导出本地落点（compose 已挂持久卷到 /data/docker/design-hub/*） ===
IMAGE_OUTPUT_DIR=/app/generated
ASSET_OUTPUT_DIR=/app/assets
EXPORT_OUTPUT_DIR=/app/exports

# === JWT（deploy.sh 用 openssl rand -hex 32 生成） ===
JWT_SECRET=__GENERATED__
JWT_TTL_HOURS=24

# === 启动 seed 管理员（角色=MANAGER；首登后请改密） ===
# 勿用 .local 等保留域名——登录边界 EmailStr 会拒（422）
SEED_ADMIN_EMAIL=admin@design-hub.cn
SEED_ADMIN_PASSWORD=__GENERATED__

# === Provider 出图密钥（决策③：首发留空，出图暂不可用；后续补齐再重启 api） ===
GPT_IMAGE_BASE_URL=
GPT_IMAGE_API_KEY=
GPT_IMAGE_MODEL=
DASHSCOPE_KEY=
OPENAI_API_KEY=

# === 监控（首发不接，留空即 no-op） ===
SENTRY_DSN=
